{
  "alwaysThinkingEnabled": true,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "effortLevel": "medium",
  "autoUpdatesChannel": "stable",
  "cleanupPeriodDays": 180,
  "tui": "fullscreen",
  "viewMode": "focus",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "additionalDirectories": ["~/Development"],
    "allow": [
      "Read",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(echo *)",
      "Bash(which *)",
      "Bash(type *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(pwd)",
      "Bash(whoami)",
      "Bash(uname *)",
      "Bash(sw_vers)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git remote *)",
      "Bash(git tag *)",
      "Bash(git stash list)",
      "Bash(curl -fsSL *)",
      "Bash(curl -s *)",
      "Bash(gh api *)",
      "Bash(gh repo view *)",
      "Bash(gh pr list *)",
      "Bash(gh issue list *)",
      "Bash(jq *)",
      "Bash(python3 *)",
      "Bash(node *)",
      "Bash(brew info *)",
      "Bash(brew list *)",
      "Bash(brew search *)",
      "Bash(mise list *)",
      "Bash(mise current *)",
      "Bash(chezmoi diff *)",
      "Bash(chezmoi status *)",
      "Bash(chezmoi data *)"
    ]
  }
}
